{
  "name": "@csvbox-io/mcp-server",
  "version": "1.0.0",
  "description": "Universal MCP server for CSVBox — create, update, patch, generate, validate and scaffold CSVBox importer sheets from any MCP-compatible client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "csvbox-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csvbox-io/csvbox-mcp-server.git"
  },
  "homepage": "https://github.com/csvbox-io/csvbox-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/csvbox-io/csvbox-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/tests"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test dist/tests/*.test.js",
    "test:unit": "npm test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "csvbox",
    "csv",
    "importer",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "openai": "^4.104.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  }
}
