# CSVBox API credentials — get these from your CSVBox dashboard.
# Required only for API-backed tools: create_sheet, update_sheet, patch_sheet,
# create_importer_from_prompt. The local tools (validate_schema,
# generate_import_code) work without credentials.
CSVBOX_API_KEY=
CSVBOX_API_SECRET=

# LLM provider — required for generate_sheet_json and create_importer_from_prompt.
# These tools call an LLM to convert a natural-language prompt into a full CSVBox
# sheet. Set ONE of the API keys below. With no key set, the tools return an
# error pointing to the create_csvbox_sheet MCP prompt (host-LLM path, no key).
#
# Provider auto-detection (when LLM_PROVIDER is unset):
#   ANTHROPIC_API_KEY present  -> anthropic
#   else OPENAI_API_KEY present -> openai
#   else                        -> no provider (tools error)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Force a provider when both keys are set: "anthropic" | "openai".
LLM_PROVIDER=

# Override the model. Defaults: anthropic -> claude-haiku-4-5, openai -> gpt-4o-mini.
LLM_MODEL=
